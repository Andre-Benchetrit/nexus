# Provider padrão: gemini, groq ou openai
LLM_PROVIDER=gemini

# Fallback automático para erros transitórios (429, 503 e timeout)
LLM_FALLBACK_PROVIDER=groq
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_DELAY_MS=500
LLM_REQUEST_TIMEOUT_MS=20000

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Groq (fallback gratuito para testes)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (opcional)
OPENAI_API_KEY=
OPENAI_MODEL=
