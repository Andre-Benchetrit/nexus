# PostgreSQL (preencha conforme o ambiente)
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Banco operacional do Nexus (governanca, memoria e auditoria)
NEXUS_DATABASE_URL=
NEXUS_MEMORY_BACKEND=postgres
NEXUS_AUTHZ_MODE=audit
NEXUS_DB_POOL_MAX=10
NEXUS_DB_CONNECT_TIMEOUT_MS=10000

# Hub Nexus (use uma App Registration exclusiva no Microsoft Entra)
NEXUS_HUB_ENTRA_TENANT_ID=
NEXUS_HUB_ENTRA_CLIENT_ID=
NEXUS_HUB_ENTRA_CLIENT_SECRET=
NEXUS_HUB_INTERNAL_SECRET=
NEXUS_API_INTERNAL_URL=http://localhost:3001
AUTH_SECRET=
AUTH_TRUST_HOST=true
NEXUS_API_PORT=3001
NEXUS_API_RATE_LIMIT_PER_MINUTE=120
NEXUS_TURN_RATE_LIMIT_PER_MINUTE=20

# Aplicacao "Nexus Lake Sync" no Microsoft Entra
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Conexao: FID - ONEDRIVE (biblioteca compartilhada)
FID_ONEDRIVE_SITE_HOST=
FID_ONEDRIVE_SITE_PATH=
FID_ONEDRIVE_SITE_ID=
FID_ONEDRIVE_DRIVE_ID=

# Conexao: AUTOMAÇÕES - ONEDRIVE (conta corporativa das automacoes/N8N)
AUTOMACOES_ONEDRIVE_USUARIO=
AUTOMACOES_ONEDRIVE_DRIVE_ID=

# Fonte inicial: planilha de agendamento de compras
ONEDRIVE_AGENDAMENTO_COMPRA_ITEM_ID=

# Thorpe (consulta somente leitura de estoque do CD)
THORPE_BASE_URL=https://apiextrema.thorpe.com.br
THORPE_API_TOKEN=
THORPE_USER=
THORPE_PASSWORD=

# Agente e roteador semantico
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDER=anthropic
LLM_REQUEST_TIMEOUT_MS=20000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_OUTPUT_TOKENS=4096

# corporate | generalist. O generalist e ativado explicitamente nesta sprint.
NEXUS_ASSISTANT_MODE=corporate
NEXUS_GENERALIST_PROVIDER=anthropic
NEXUS_GENERALIST_MODEL=claude-sonnet-5
NEXUS_GENERALIST_FALLBACK_PROVIDER=groq
NEXUS_GENERALIST_FALLBACK_MODEL=openai/gpt-oss-120b
NEXUS_GENERALIST_HISTORY_MESSAGES=20
NEXUS_USAGE_POLICY_MODE=observe

# Continuidade entre providers e memoria longa governada
# legacy | shadow | v1
NEXUS_HANDOFF_MODE=shadow
# off | shadow | assist
NEXUS_PLAYBOOK_MODE=shadow
# off | observe | propose
NEXUS_MEMORY_AUTOMATION_MODE=observe
NEXUS_MEMORY_REVIEW_PROVIDER=
NEXUS_MEMORY_REVIEW_MODEL=
NEXUS_MEMORY_OFFER_TTL_HOURS=24

# legacy | shadow | v2
NEXUS_ROUTER_MODE=shadow
# Se vazios, o roteador usa a configuracao principal.
NEXUS_ROUTER_PROVIDER=
NEXUS_ROUTER_MODEL=
NEXUS_SESSION_HISTORY_LIMIT=10
NEXUS_MAX_RODADAS=10

# Armazenamento portatil do lake. No Railway, monte o volume em /data/nexus-lake.
NEXUS_LAKE_STORAGE=filesystem
NEXUS_LAKE_ROOT=
NEXUS_LAKE_REQUIRE_DATA=0
NEXUS_LAKE_SCHEDULER_ENABLED=0
NEXUS_LAKE_INTRADAY_MINUTE=15

# Escalonamento semantico. Em shadow apenas recomenda e audita a faixa.
# off | shadow | v1
NEXUS_SEMANTIC_ESCALATION_MODE=shadow
NEXUS_SEMANTIC_BASIC_MAX_SCORE=1
NEXUS_SEMANTIC_ASSISTED_MAX_SCORE=3
# Faixa basica vazia reutiliza LLM_PROVIDER (Groq nesta configuracao).
NEXUS_MODEL_TIER_BASIC_PROVIDER=
NEXUS_MODEL_TIER_BASIC_MODEL=
NEXUS_MODEL_TIER_ASSISTED_PROVIDER=anthropic
NEXUS_MODEL_TIER_ASSISTED_MODEL=claude-haiku-4-5
NEXUS_MODEL_TIER_ADVANCED_PROVIDER=anthropic
NEXUS_MODEL_TIER_ADVANCED_MODEL=claude-sonnet-5

# Gemini fica preparado, mas desativado ate aprovacao de custo e politica de dados.
# disabled | free_public | paid
NEXUS_GEMINI_USAGE_MODE=disabled

# Pesquisa web governada. Em shadow apenas classifica a necessidade de busca.
# off | shadow | v1
NEXUS_WEB_MODE=off
NEXUS_WEB_PROVIDER=tavily
NEXUS_WEB_MAX_SEARCHES_PER_TURN=3
NEXUS_WEB_MAX_RESULTS=5
NEXUS_WEB_MIN_SCORE=0.2
NEXUS_WEB_TIMEOUT_MS=10000
TAVILY_API_KEY=

# Imagens locais e visão. local nunca envia imagens ao provider.
# off | local | v1
NEXUS_IMAGE_MODE=off
NEXUS_ATTACHMENT_STORAGE=filesystem
NEXUS_ATTACHMENTS_ROOT=
NEXUS_IMAGE_MAX_FILES=4
NEXUS_IMAGE_MAX_BYTES=10485760
NEXUS_IMAGE_MAX_PIXELS=20000000
NEXUS_OCR_LANGS=por+eng
NEXUS_VISION_PROVIDER=anthropic
NEXUS_VISION_MODEL=

# Leitura local e analise governada de PDF, DOCX, XLS e XLSX.
# off | read | v1 (read valida/extrai; v1 tambem permite sintese pelo LLM).
NEXUS_FILES_MODE=off
NEXUS_FILES_ROOT=
NEXUS_FILES_MAX_FILES=4
NEXUS_FILES_MAX_BYTES=26214400
NEXUS_PDF_MAX_PAGES=200
NEXUS_DOCX_MAX_IMAGES=50
NEXUS_XLSX_MAX_SHEETS=20
NEXUS_XLSX_MAX_CELLS=250000
# Limite agregado de texto/valores decodificados por arquivo, contra expansão lógica excessiva.
NEXUS_FILE_MAX_EXTRACTED_TEXT_BYTES=67108864

# Inteligência persistente de anexos. Em shadow cria e audita o IR sem alterar o prompt/roteamento;
# em v1 a análise canônica passa a ser obrigatória antes do roteamento.
# off | shadow | v1
NEXUS_ATTACHMENT_INTELLIGENCE_MODE=off
# O prompt nunca recebe mais que este total de evidências estruturadas.
NEXUS_ATTACHMENT_EVIDENCE_MAX_BYTES=32768
# Orçamentos máximos após descompressão dos derivados locais.
NEXUS_ATTACHMENT_IR_MAX_BYTES=134217728
NEXUS_ATTACHMENT_ANALYSIS_MAX_BYTES=33554432

# Geracao privada de arquivos na conversa. shadow constroi e valida sem expor.
# off | shadow | v1
NEXUS_ARTIFACTS_MODE=off
NEXUS_ARTIFACTS_ROOT=
NEXUS_ARTIFACT_MAX_BYTES=52428800
# JSON de marca por implantacao. Mantenha entre aspas para que cores com # nao virem comentario no .env.
# Exemplo: '{"nome":"Empresa","cores":{"primaria":"#0b6b45"}}'
NEXUS_ARTIFACT_BRAND_JSON=
# Caminho local/volume para logo PNG autorizado.
NEXUS_ARTIFACT_BRAND_LOGO=

# Cruzamento temporario de XLS/XLSX com dados corporativos e reutilizacao de resultados.
# off preserva o fluxo atual; shadow somente classifica; v1 materializa e consulta.
NEXUS_DATASETS_MODE=off
NEXUS_DATASETS_ROOT=
NEXUS_DATASET_MAX_KEYS=50000
NEXUS_DATASET_MAX_ROWS=50000
NEXUS_DATASET_TTL_HOURS=24
NEXUS_DATASET_QUERY_TIMEOUT_MS=30000

# Base governada de procedimentos, politicas e manuais
# off | shadow | v1
NEXUS_KNOWLEDGE_MODE=shadow
NEXUS_KNOWLEDGE_STORAGE=filesystem
NEXUS_KNOWLEDGE_ROOT=
NEXUS_KNOWLEDGE_MAX_BYTES=52428800
NEXUS_KNOWLEDGE_CHUNK_CHARS=1800
# e5 usa o modelo local multilingual-e5-small; hash e fallback leve para desenvolvimento.
NEXUS_KNOWLEDGE_EMBEDDING_MODE=e5
NEXUS_KNOWLEDGE_EMBEDDING_MODEL=Xenova/multilingual-e5-small
NEXUS_KNOWLEDGE_VISION_PROVIDER=anthropic
NEXUS_KNOWLEDGE_VISION_MODEL=
NEXUS_KNOWLEDGE_VISION_MAX_PAGES=2
NEXUS_EMBEDDING_CACHE_ROOT=
NEXUS_EMBEDDING_ALLOW_DOWNLOAD=1
NEXUS_KNOWLEDGE_ONEDRIVE_ROOT_ITEM_ID=
NEXUS_KNOWLEDGE_ONEDRIVE_ROOT_PATH=
# Lista JSON de pastas e/ou arquivos. Quando preenchida, substitui as duas opcoes singulares acima.
# Ex.: [{"key":"procedimentos","rootItemId":"..."},{"key":"politica-global","itemId":"...","tipo":"politica","escopo":"global"}]
NEXUS_KNOWLEDGE_ONEDRIVE_SOURCES_JSON=
NEXUS_KNOWLEDGE_ONEDRIVE_WRITE_ENABLED=0
NEXUS_KNOWLEDGE_ONEDRIVE_PUBLISH_ROOT_PATH=
NEXUS_KNOWLEDGE_LOCAL_IMPORT_ROOT=
NEXUS_KNOWLEDGE_SYNC_PRINCIPAL=knowledge-sync
